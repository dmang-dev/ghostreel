{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "ghostreel",
  "outputfilename": "ghostreel-desktop",
  "frontend:dir": "../viewer",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build:desktop",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "wailsjsdir": "./frontend",
  "author": {
    "name": "ghostreel contributors"
  },
  "info": {
    "companyName": "ghostreel contributors",
    "productName": "ghostreel",
    "productVersion": "1.0.0",
    "copyright": "Copyright © ghostreel contributors. Apache-2.0.",
    "comments": "Replay viewer. Not affiliated with Blizzard Entertainment.",
    "fileAssociations": [
      {
        "ext": "SC2Replay",
        "name": "ghostreel.SC2Replay",
        "description": "SC2 replay",
        "iconName": "replayicon",
        "role": "Viewer"
      }
    ]
  }
}
