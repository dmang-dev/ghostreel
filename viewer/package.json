{
  "name": "ghostreel-viewer",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:desktop": "tsc --noEmit && vite build --outDir ../desktop/frontend/dist --emptyOutDir && node scripts/gitkeep.mjs ../desktop/frontend/dist",
    "build:web": "node scripts/build-wasm.mjs && tsc --noEmit && vite build --mode web",
    "dev:web": "node scripts/build-wasm.mjs && vite --mode web"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
